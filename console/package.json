{
  "name": "@workspacenow/monorepo",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web-ui run dev",
    "build": "pnpm --filter web-ui run build",
    "typecheck": "pnpm -r --no-sort run typecheck",
    "lint": "pnpm -r --no-sort run lint",
    "test": "pnpm -r --no-sort run test"
  },
  "pnpm": {
    "overrides": {
      "typescript": "6.0.3"
    }
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
