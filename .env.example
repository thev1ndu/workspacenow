# Local stack configuration. Copy to .env at the repo root (gitignored) and edit:

# Image tag for the four app images on GHCR (images.yaml pushes main-<sha>-<run> on every main push).
IMAGE_TAG=main

# --- secrets ---

# Mistral API key for wsn-ai-service agent runs and planning. Without it the stack still boots,
MISTRAL_API_KEY=

# Shared secret between wsn-service and wsn-ai-service: wsn-service presents it as
AI_SERVICE_TOKEN=dev-service-token

# Bearer token for wsn-observer ingest/query. Empty = no auth (local dev only).
OBSERVER_TOKEN=

# --- infra credentials (defaults match the compose file's built-in defaults) ---

POSTGRES_USER=workspacenow
POSTGRES_PASSWORD=workspacenow
POSTGRES_DB=workspacenow

RUSTFS_ACCESS_KEY=workspacenow
RUSTFS_SECRET_KEY=workspacenow-secret

# OpenBao dev-mode root token.
OPENBAO_ROOT_TOKEN=root

# --- switching to real OIDC instead of demo persona tokens ---

# --- first administrators (real OIDC mode) ---
