# Copy to .env for local development; defaults match deploy/compose/docker-compose.yml.

WSN_ENV=development
LOG_LEVEL=DEBUG
# Demo mode: demo.<userId> tokens, GET /personas and POST /demo/reset. Never in production.
WSN_DEMO_MODE=true
WSN_HTTP_ADDR=:8080
WSN_INTERNAL_ADDR=:8081
CORS_ALLOWED_ORIGINS=http://localhost:3100

DATABASE_URL=postgres://workspacenow:workspacenow@localhost:5432/workspacenow?sslmode=disable
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
TEMPORAL_HOSTPORT=localhost:7233
TEMPORAL_NAMESPACE=default

S3_ENDPOINT=localhost:9000
S3_BUCKET=workspacenow
S3_ACCESS_KEY=workspacenow
S3_SECRET_KEY=workspacenow-secret

OPENBAO_ADDR=http://localhost:8200
OPENBAO_MOUNT=secret
OPENBAO_TOKEN=root

# Required when WSN_DEMO_MODE=false: the identity provider that issues access tokens.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

AI_SERVICE_URL=http://localhost:8090
AI_SERVICE_TOKEN=dev-ai-service-token
# Base64 Ed25519 seed that signs agent run grants; make keys prints one.
RUN_GRANT_KEY=
