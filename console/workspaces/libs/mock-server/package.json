{
  "name": "@workspacenow/mock-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "In-browser WorkspaceNow platform runtime used by the demo console",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test-watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@workspacenow/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@workspacenow/eslint-config": "workspace:*",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
