{
  "name": "@workspacenow/mock-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "In-browser WorkspaceNow platform runtime used by the demo console",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test-watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@workspacenow/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.1.9",
    "@vitest/coverage-v8": "^3.2.4",
    "@workspacenow/eslint-config": "workspace:*",
    "eslint": "9.36.0",
    "typescript": "5.9.3",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
