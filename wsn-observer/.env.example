# Copy to .env for local development.
WSN_OBSERVER_PORT=9098
WSN_OBSERVER_LOG_LEVEL=INFO
# Optional shared bearer token required on the ingest and query APIs.
WSN_OBSERVER_TOKEN=
# All telemetry (traces, logs, metrics) is appended as JSONL segment files under this dir.
WSN_OBSERVER_DATA_DIR=./data
# Max bytes kept per signal (traces/logs/metrics); oldest segments are pruned past this.
WSN_OBSERVER_RETENTION_BYTES=268435456
# Roll the active segment file past this size.
WSN_OBSERVER_SEGMENT_BYTES=33554432
# Max records a query scans per signal, newest first.
WSN_OBSERVER_SCAN_LIMIT=100000
