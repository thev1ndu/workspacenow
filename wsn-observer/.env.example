# Copy to .env for local development.
WSN_OBSERVER_PORT=9098
WSN_OBSERVER_LOG_LEVEL=INFO
# Max entries kept per signal (spans, logs, metrics); the oldest are dropped past this.
WSN_OBSERVER_RETENTION=10000
# Optional shared bearer token required on the ingest and query APIs.
# In Kubernetes the NetworkPolicy already limits callers; leave empty to rely on it.
WSN_OBSERVER_TOKEN=
